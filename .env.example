# Copia este archivo como .env y pon tu clave (solo para pruebas locales).
# En Vercel, configúrala en Settings → Environment Variables.
GEMINI_API_KEY=pega_aqui_tu_clave
# Opcional: modelo de Gemini a usar
GEMINI_MODEL=gemini-flash-latest
# Opcional: DEMO_MODE=1 fuerza respuestas de demostración sin IA (sin clave también se activa solo)
# Panel /admin: clave de administrador (en tu computador, si no la pones, es "admin")
ADMIN_PASSWORD=
# Firma de los enlaces de huéspedes (una frase larga cualquiera)
LINK_SECRET=
# Opcional: claves por cabaña → los-arrayanes:clave1,el-mirador:clave2
CLAVES_CABANAS=
# Solo en Vercel: para que el panel guarde haciendo commit en GitHub
# GITHUB_TOKEN=
# GITHUB_REPO=tu-usuario/conserje-caba-as
# GITHUB_BRANCH=main
