# Copia este archivo como .env y pon tu clave (solo para pruebas locales).
# En Vercel, configúrala en Settings → Environment Variables.
GEMINI_API_KEY=pega_aqui_tu_clave
# Opcional: modelo de Gemini a usar
GEMINI_MODEL=gemini-flash-latest
# Opcional: DEMO_MODE=1 fuerza respuestas de demostración sin IA (sin clave también se activa solo)
